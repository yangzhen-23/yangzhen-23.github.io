---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <p class="site-footer__title">保持好奇，也保持诚实。</p>
      <p class="site-footer__note">记录项目、论文阅读与一路上的思考。</p>
    </div>
    <nav aria-label="页脚链接">
      <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={SITE.orcid} target="_blank" rel="noreferrer">ORCID</a>
      <a href="/rss.xml">RSS</a>
      <a href={SITE.email}>邮箱</a>
    </nav>
  </div>
  <div class="shell site-footer__copyright">
    <span>© {year} YangZhen</span>
    <span>Built with Astro · Hosted on GitHub Pages</span>
  </div>
</footer>

