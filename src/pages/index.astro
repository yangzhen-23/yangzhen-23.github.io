---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import { PROJECTS } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished, sortPosts } from '../lib/content';
import { SITE } from '../lib/site';

const posts = sortPosts((await getCollection('blog')).filter((entry) => isPublished(entry))).slice(0, 3);
const featuredProjects = PROJECTS.filter((project) => project.featured);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__content">
        <p class="eyebrow">Personal space · Notes & projects</p>
        <h1>探索、记录，<br />也保持好奇。</h1>
        <p class="hero__lead">这里收录我的项目、技术阅读与学习过程。写下已经想清楚的，也保留仍在追问的问题。</p>
        <div class="button-row">
          <a class="button button--primary" href="/blog/">开始阅读</a>
          <a class="button" href={SITE.github} target="_blank" rel="noreferrer">访问 GitHub</a>
        </div>
      </div>

      <aside class="profile-card" aria-label="个人资料">
        <div class="profile-card__avatar">
          <span aria-hidden="true">YZ</span>
          <img src={SITE.avatar} alt="YangZhen 的 GitHub 头像" width="220" height="220" data-avatar />
        </div>
        <p class="profile-card__label">Hello, I am</p>
        <p class="profile-card__name">YangZhen</p>
        <p class="profile-card__handle">@yangzhen-23</p>
        <div class="profile-card__rule"></div>
        <p class="profile-card__meta">Projects · Research notes · Open source</p>
      </aside>
    </div>
    <div class="hero__glow" aria-hidden="true"></div>
  </section>

  <section class="quote-section shell" aria-label="引言">
    <span class="quote-section__mark" aria-hidden="true">“</span>
    <blockquote>
      <p>真正有价值的记录，不是把答案写得多么确定，而是让后来的人看见：问题曾经怎样展开，判断又如何一步步形成。</p>
    </blockquote>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>精选项目</h2>
      </div>
      <a href="/projects/">查看全部 <span aria-hidden="true">→</span></a>
    </div>
    <div class="card-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Recent writing</p>
        <h2>最新文章</h2>
      </div>
      <a href="/blog/">进入博客 <span aria-hidden="true">→</span></a>
    </div>
    {
      posts.length > 0 ? (
        <div class="home-posts">
          {posts.map((post, index) => (
            <article class="home-post">
              <span class="home-post__number">0{index + 1}</span>
              <div>
                <p class="home-post__meta">
                  {post.data.category} · {post.data.publishedAt.toLocaleDateString('zh-CN')}
                </p>
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-note">
          <p>第一篇文章正在整理中。</p>
          <span>从一份完整的论文精读开始，把材料重新写成能读、能讨论的技术文章。</span>
        </div>
      )
    }
  </section>

  <script>
    document.querySelectorAll<HTMLImageElement>('[data-avatar]').forEach((avatar) => {
      avatar.addEventListener('error', () => avatar.remove());
    });
  </script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(780px, calc(100vh - 68px));
    overflow: hidden;
    border-bottom: 1px solid rgba(151, 166, 198, 0.13);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 15, 23, 0.94), rgba(11, 15, 23, 0.55) 58%, rgba(11, 15, 23, 0.88)),
      radial-gradient(circle at 72% 34%, rgba(79, 94, 187, 0.22), transparent 26rem);
    content: "";
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: min(780px, calc(100vh - 68px));
    padding-block: 88px;
    align-items: center;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(52px, 8vw, 112px);
  }

  .hero h1 {
    max-width: 10ch;
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-serif);
    font-size: clamp(3.1rem, 7.4vw, 6.8rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 1.08;
  }

  .hero__lead {
    max-width: 610px;
    margin: 28px 0 32px;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .profile-card {
    position: relative;
    padding: 26px;
    border: 1px solid var(--border-strong);
    border-radius: 28px 28px 28px 8px;
    background: linear-gradient(160deg, rgba(28, 41, 65, 0.78), rgba(13, 19, 30, 0.82));
    box-shadow: var(--shadow);
  }

  .profile-card__avatar {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: radial-gradient(circle at 40% 30%, #344574, #101522 66%);
    color: rgba(230, 234, 242, 0.18);
    font-size: 68px;
    font-weight: 800;
  }

  .profile-card__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-card__label {
    margin: 22px 0 0;
    color: var(--muted-2);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .profile-card__name {
    margin: 2px 0 0;
    color: var(--text-strong);
    font-size: 30px;
    font-weight: 750;
    letter-spacing: -0.04em;
  }

  .profile-card__handle,
  .profile-card__meta {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .profile-card__rule {
    height: 1px;
    margin: 20px 0;
    background: linear-gradient(90deg, var(--border-strong), transparent);
  }

  .hero__glow {
    position: absolute;
    right: 10%;
    bottom: -260px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: rgba(106, 91, 200, 0.12);
    filter: blur(110px);
  }

  .quote-section {
    position: relative;
    display: grid;
    max-width: 920px;
    padding-block: 104px 70px;
    grid-template-columns: auto 1fr;
    gap: 24px;
  }

  .quote-section__mark {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 82px;
    line-height: 0.8;
    opacity: 0.7;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.7;
  }

  .home-posts {
    border-top: 1px solid var(--border);
  }

  .home-post {
    display: grid;
    padding-block: 28px;
    border-bottom: 1px solid var(--border);
    grid-template-columns: 70px 1fr;
    gap: 24px;
  }

  .home-post__number {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 24px;
  }

  .home-post__meta,
  .home-post p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .home-post h3 {
    margin: 5px 0 8px;
    color: var(--text-strong);
    font-family: var(--font-serif);
    font-size: 23px;
  }

  .home-post h3 a {
    text-decoration: none;
  }

  .empty-note {
    padding: 36px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    background: rgba(17, 24, 39, 0.45);
  }

  .empty-note p,
  .empty-note span {
    margin: 0;
  }

  .empty-note p {
    color: var(--text-strong);
    font-size: 20px;
    font-weight: 700;
  }

  .empty-note span {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .hero__grid {
      min-height: auto;
      padding-block: 72px;
      grid-template-columns: 1fr;
    }

    .profile-card {
      width: min(100%, 410px);
    }
  }

  @media (max-width: 560px) {
    .hero h1 {
      font-size: clamp(2.9rem, 16vw, 4.2rem);
    }

    .quote-section {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .home-post {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>

